* {
  margin: 0;
  padding: 0;
  border: 0;
  font-family: "Nunito Sans";
  background: #ffffff;
  color: #000000;
}

/* status colors */
.status-success { color: #447979; }
.status-warning { color: #906a29; }
.status-error { color: #d42f3d; }

/* Small utility */
.muted { color: #6b6b6b; }

#MainContainer {
  background-color: white;
  padding: 2px;
}

#MainContainer[state="normal"] {
  border-radius: 14px;
  border: 1px solid rgba(0, 0, 0, 8%);
}

#MainContainer[state="maximized"] {
  border-radius: 0px;
  border: none;
}

#TitleBar {
  margin: 0;
}

#Content {
  background: transparent;
  border: none;
  padding: 0;
}

QWidget {
  selection-background-color: #0090ff;
  selection-color: #000000;
}

QPushButton[role="close"][variant="default"]
{
  background: #e5e5e5;
  color: #000000;
  border: 1px solid #dfdfdf;
  border-radius: 6px;
  padding: 8px;
}

QPushButton[role="close"][variant="default"]:hover {
  background: #e6e6e6;
  border: 2px solid #d42f3d;
}

QPushButton[role="close"][variant="default"]:pressed {
  background: #d42f3d;
  color: #000000;
}

QPushButton[role="close"][variant="default"]:disabled {
  background: #d9d9d9;
  color: #2d344b;
  border-color: #d0d0d0;
}

QPushButton
{
  background: #e5e5e5;
  color: #000000;
  border: 1px solid #dfdfdf;
  border-radius: 6px;
  padding: 8px;
}

QFrame[role="frame-button"][variant="default"] * {
  background: transparent;
}

QFrame[role="frame-button"][variant="default"] {
  background: #e5e5e5;
  color: #000000;
  border: 1px solid #dfdfdf;
  border-radius: 14px;
  padding: 6px;
}

QWidget[role="in-tab"][variant="default"] QFrame[role="frame-button"][variant="default"] {
  background: #e5e5e5;
  border: 1px solid #dfdfdf;
}

QFrame[role="frame-button"][variant="default"]:hover,
QPushButton:hover {
  background: #e6e6e6;
  border: 2px solid #0090ff;
}

QWidget[role="in-tab"][variant="default"] QFrame[role="frame-button"][variant="default"]:hover {
  background: #e6e6e6;
  border: 2px solid #0090ff;
}

QFrame[role="frame-button"][variant="default"][state="pressed"],
QPushButton:pressed {
  background: #0090ff;
  color: #000000;
}

QFrame[role="frame-button"][variant="default"][state="checked"] {
  background: #0090ff;
  border: 2px solid #0090ff;
}

QWidget[role="in-tab"][variant="default"] QFrame[role="frame-button"][variant="default"][state="checked"] {
  background: #0090ff;
  border: 2px solid #0090ff;
}

QFrame[role="frame-button"][variant="default"][state="dissabled"],
QPushButton:disabled {
  background: #d9d9d9;
  color: #2d344b;
  border-color: #d0d0d0;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
  background: #f5f5f5;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  padding: 4px;
  color: #000000;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button
{
  background-color: #0090ff;
  border: none;
  padding: 2px;
  margin-top: 1px;
  margin-bottom: 1px;
  margin-right: 2px;
  border-radius: 4px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover
{
  background-color: #0080df;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed
{
  background-color: #ffffff;
}


QScrollBar {
  background: #f5f5f5;
  border: none;
}

QScrollBar:vertical {
  border-radius: 6px;
  width: 12px;
}

QScrollBar::horizontal {
  border-radius: 6px;
  height: 12px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
  background: #c6c6c6;
  border-radius: 6px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
  background: #0090ff;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
  background: #0080df;
}

QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
  background: #d0d0d0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  background: transparent;
  border: none;
}

QWidget[role="in-tab"][variant="default"] {
  background: #f5f5f5;
  border: 1px solid #f0f0f0;
  border-top-right-radius: 14px;
  border-bottom-left-radius: 14px;
  border-bottom-right-radius: 14px;
}

QWidget[role="in-tab"][variant="default"] QWidget {
  background: #f5f5f5;
}

QWidget[role="in-tab"][variant="default"] QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
  padding: 4px;
  border-radius: 6px;
  background: #ffffff;
  color: #000000;
}

QWidget[role="in-tab"][variant="default"] QPushButton,
QWidget[role="in-tab"][variant="default"] QPushButton:hover
{
  background: #ffffff;
}

QGroupBox {
  background: transparent;
  padding-top: 18px;
  padding-left: 2px;
  padding-right: 2px;
  padding-bottom: 2px;
  color: #000000;
  border-radius: 8px;
  border: 1px solid #dfdfdf;
}

QTabBar::tab {
  background: transparent;
  padding: 6px 10px;
}

QTabBar::tab:selected {
  background: #0090ff;
  color: #000000;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
}

QTabBar::tab:!selected {
  background: #e5e5e5;
  color: #000000;
  border: 1px solid #dfdfdf;
  border-bottom: none;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
}

QTableView {
  background: #f5f5f5;
  border-radius: 6px;
  padding: 4px;
  color: #000000;
  gridline-color: #e0e0e0;
}

QTableView *
{
  border: none;
  background: #f5f5f5;
}

QTableView QHeaderView,
QTableView::item {
  background: #f5f5f5;
  color: #000000;
  border: none;
}

QComboBox {
  combobox-popup: 0;
  background: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
}

QComboBox * {
  background: #ffffff;
  color: #000000;
}

QComboBox:on {
  background: #ffffff;
}

QComboBox QAbstractItemView {
  background-color: #ffffff;
  border: 1px solid #0090ff; 
  selection-background-color: #0090ff; 
  outline: none; 
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected 
{
  background-color: #0090ff;
  color: #000000;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button
{
  background-color: #dfdfdf;
  border: none;
  padding: 2px;
  margin-top: 1px;
  margin-bottom: 1px;
  margin-right: 2px;
  border-radius: 4px;
}

QComboBox::drop-down {
  background: #f5f5f5;
  border: none;
  border-radius: 4px;
  margin: 4px;
  padding: 2px;
  width: 16px;
}

QComboBox::down-arrow {
  width: 12px;
}

QComboBox::drop-down:hover,
QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover
{
  background-color: #ffffff;
}

QComboBox::drop-down:pressed,
QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed
{
  background-color: #000000;
}

QWidget[role="node-list"][variant="default"],
QWidget[role="node-list"][variant="default"] QWidget {
  margin: 0;
}

QWidget[role="node-scroll"][variant="default"] QLabel {
  padding-left: 5px;
  border-left: 4px solid #e0e0e0;
}

QMessageBox {
  background-color: white;
  color: #000000;
  padding: 8px;
  border: 1px solid rgba(0, 0, 0, 8%);
}

/* Status bar */
QFrame[role="status-bar"] {
  border: none;
  margin: 0px;
  padding: 0px;
}

QFrame[role="status-bar"] QLabel {
  margin: 0;
  padding: 0;
  border: none;
}

QFrame[role="central"] QTabWidget::pane {
  border: 1px solid #dfdfdf;
  border-radius: 8px;
}

QFrame[role="central"] QTabBar {
  background: #00000000;
}

QFrame[role="central-shortcuts"] QTabBar::tab {
  margin: 4px 4px 0px 0px;
  border-radius: 4px;
}

QFrame[role="central"] QTabBar::tab:!selected {
  background: #00000000;
}

QFrame[role="central"] QTreeWidget {
  padding-left: 4px;
  border: none;
  qproperty-indentation: 16px;
  qproperty-rootIsDecorated: false;
}

/* Completely remove branch indicators and space */
QFrame[role="central"] QTreeView::branch {
  width: 0px;
  border-image: none;
  image: none;
}

QTextEdit {
  font-family: 'UbuntuMono Nerd Font Mono', 'Ubuntu Mono', monospace;
}

QLabel[role="info_label"][variant="default"][state="normal"] {
  font-size: 10pt;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
  background-color: #dfdfdf;
}

/*RADIO BUTTONS AND CHECKBOXES borders #0090ff*/
QRadioButton::indicator {
  width: 12px;
  height: 12px;
  border-radius: 7px;
  border: 2px solid #0090ff;
}

QRadioButton::indicator:checked {
  background: #0090ff;
}

QRadioButton::indicator:unchecked {
  background: transparent;
}

QCheckBox::indicator {
  width: 12px;
  height: 12px;
  border: 2px solid #0090ff;
}

QCheckBox::indicator:checked {
  background: #0090ff;
}

QCheckBox::indicator:unchecked {
  background: transparent;
}
